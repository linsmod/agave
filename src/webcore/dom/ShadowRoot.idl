module core {

    /* Shadow DOM (issues #18 phase C). The tree has no shadow tree at all: the
     * facade binds a ShadowRoot wrapper to the host element and its children are
     * the host's real children, so what components render is what layout paints.
     * The wrapper carries the node tag too, which is why the DocumentFragment /
     * Node surface (appendChild, querySelector, innerHTML, childNodes, ...) works
     * on it without new code. */
    interface [
        GenerateConstructor
    ] ShadowRoot : DocumentFragment {
        readonly attribute Element host;
        readonly attribute DOMString mode;

        /* ShadowRoot has innerHTML (DocumentFragment partial in the spec). The
         * generated accessor is what lets the facade answer it through the host. */
        attribute DOMString innerHTML;
    };

}
